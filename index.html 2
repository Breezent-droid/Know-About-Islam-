          </div>

          <div class="progress-meta">

            <span id="lessonsCompleted">
              0 lessons completed
            </span>

            <span id="learningStreak">
              🔥 0 day streak
            </span>

          </div>

        </div>

      </section>


      <!-- CORE KNOWLEDGE -->

      <section class="section">

        <div class="section-heading">

          <h3>
            Explore Knowledge
          </h3>

          <span>
            Learn
          </span>

        </div>

        <div class="feature-grid">

          <a
            href="#quran"
            class="feature-card"
            data-section="quran"
          >

            <div class="feature-icon">
              📖
            </div>

            <div>
              <h4>Qur'an</h4>
              <p>Read, search and reflect.</p>
            </div>

          </a>


          <a
            href="#hadith"
            class="feature-card"
            data-section="hadith"
          >

            <div class="feature-icon">
              📜
            </div>

            <div>
              <h4>Hadith</h4>
              <p>Explore Prophetic guidance.</p>
            </div>

          </a>


          <a
            href="#adhkar"
            class="feature-card"
            data-section="adhkar"
          >

            <div class="feature-icon">
              🤲
            </div>

            <div>
              <h4>Adhkar</h4>
              <p>Remember Allah daily.</p>
            </div>

          </a>


          <a
            href="#fiqh"
            class="feature-card"
            data-section="fiqh"
          >

            <div class="feature-icon">
              🕌
            </div>

            <div>
              <h4>Fiqh</h4>
              <p>Learn Islamic rulings.</p>
            </div>

          </a>


          <a
            href="#sunnah"
            class="feature-card"
            data-section="sunnah"
          >

            <div class="feature-icon">
              🌙
            </div>

            <div>
