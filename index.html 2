<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0, viewport-fit=cover"
  >

  <meta
    name="description"
    content="Know About Islam — Learn, reflect and grow through Qur'an, Hadith, Fiqh, Adhkar and Islamic knowledge."
  >

  <meta name="theme-color" content="#0b1220">

  <title>Know About Islam — V2</title>

  <!-- Existing project stylesheet -->
  <link rel="stylesheet" href="style-v2.css">

  <!-- Google Font -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

  <link
    href="https://fonts.googleapis.com/css2?family=Amiri:wght@400;700&family=Inter:wght@400;500;600;700;800&display=swap"
    rel="stylesheet"
  >

  <style>
    /* =========================================================
       KNOW ABOUT ISLAM — V2 FOUNDATION
       Temporary V2 styling.
       We will move/refine this into style.css in Step 2.
       ========================================================= */

    :root {
      --bg: #07111f;
      --bg-soft: #0d1a2b;
      --card: rgba(255, 255, 255, 0.06);
      --card-border: rgba(255, 255, 255, 0.1);
      --text: #f5f7fa;
      --muted: #9daabd;
      --primary: #25c58a;
      --primary-dark: #12976a;
      --gold: #d9b45b;
      --danger: #ef6b73;
      --radius: 20px;
      --shadow: 0 20px 50px rgba(0, 0, 0, 0.25);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      min-height: 100vh;
      background:
        radial-gradient(
          circle at top right,
          rgba(37, 197, 138, 0.12),
          transparent 35%
        ),
        radial-gradient(
          circle at bottom left,
          rgba(217, 180, 91, 0.08),
          transparent 30%
        ),
        var(--bg);

      color: var(--text);
      font-family: "Inter", sans-serif;
      line-height: 1.6;
    }

    button,
    input {
      font: inherit;
    }

    button {
      cursor: pointer;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    .app-shell {
      width: 100%;
      min-height: 100vh;
      padding-bottom: 90px;
    }

    /* ================= HEADER ================= */

    .topbar {
      position: sticky;
      top: 0;
      z-index: 1000;

      display: flex;
      align-items: center;
      justify-content: space-between;

      padding: 15px 18px;

      background: rgba(7, 17, 31, 0.9);
      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);

      border-bottom: 1px solid var(--card-border);
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 11px;
    }

    .brand-icon {
      width: 43px;
      height: 43px;

      display: grid;
      place-items: center;

      border-radius: 14px;

      background:
        linear-gradient(
          135deg,
          var(--primary),
          var(--primary-dark)
        );

      color: #fff;
      font-size: 22px;
      box-shadow: 0 8px 25px rgba(37, 197, 138, 0.2);
    }

    .brand-text h1 {
      font-size: 16px;
      line-height: 1.2;
      font-weight: 800;
    }

    .brand-text span {
      display: block;
      color: var(--muted);
      font-size: 10px;
      margin-top: 2px;
    }

    .header-actions {
      display: flex;
      gap: 8px;
    }

    .icon-btn {
      width: 42px;
      height: 42px;

      display: grid;
      place-items: center;

      border: 1px solid var(--card-border);
      border-radius: 13px;

      background: var(--card);
      color: var(--text);

      transition: 0.2s ease;
    }

    .icon-btn:active {
      transform: scale(0.94);
    }

    /* ================= MAIN ================= */

    main {
      width: min(1100px, 100%);
      margin: auto;
      padding: 22px 16px;
    }

    .hero {
      position: relative;
      overflow: hidden;

      padding: 28px 22px;
      border-radius: 26px;

      background:
        linear-gradient(
          135deg,
          rgba(37, 197, 138, 0.2),
          rgba(217, 180, 91, 0.08)
        );

      border: 1px solid rgba(37, 197, 138, 0.18);
      box-shadow: var(--shadow);
    }

    .hero::after {
      content: "☪";

      position: absolute;
      right: -15px;
      bottom: -35px;

      font-family: serif;
      font-size: 150px;

      color: rgba(255,255,255,0.035);
      pointer-events: none;
    }

    .hero-label {
      display: inline-flex;
      align-items: center;
      gap: 7px;

      padding: 6px 10px;
      border-radius: 999px;

      background: rgba(255,255,255,0.07);
      color: var(--primary);

      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.3px;
    }

    .hero h2 {
      margin-top: 14px;

      max-width: 650px;

      font-size: clamp(28px, 7vw, 48px);
      line-height: 1.1;
      font-weight: 800;
    }

    .hero p {
      margin-top: 12px;

      max-width: 650px;

      color: var(--muted);
      font-size: 14px;
    }

    .arabic {
      margin-top: 20px;

      font-family: "Amiri", serif;
      font-size: 25px;
      color: var(--gold);

      direction: rtl;
    }

    /* ================= SEARCH ================= */

    .search-wrapper {
      margin-top: 18px;
      position: relative;
    }

    .search-wrapper input {
      width: 100%;

      padding: 16px 18px 16px 48px;

      border: 1px solid var(--card-border);
      border-radius: 17px;

      outline: none;

      background: rgba(255,255,255,0.055);
      color: var(--text);

      transition: 0.2s ease;
    }

    .search-wrapper input::placeholder {
      color: #718095;
    }

    .search-wrapper input:focus {
      border-color: rgba(37,197,138,0.5);
      box-shadow: 0 0 0 4px rgba(37,197,138,0.08);
    }

    .search-icon {
      position: absolute;
      left: 17px;
      top: 50%;
      transform: translateY(-50%);

      color: var(--muted);
    }

    /* ================= SECTION ================= */

    .section {
      margin-top: 28px;
    }

    .section-heading {
      display: flex;
      align-items: center;
      justify-content: space-between;

      margin-bottom: 13px;
    }

    .section-heading h3 {
      font-size: 18px;
      font-weight: 800;
    }

    .section-heading span {
      color: var(--muted);
      font-size: 11px;
    }

    /* ================= DASHBOARD ================= */

    .progress-card {
      padding: 19px;

      border-radius: var(--radius);

      background: var(--card);
      border: 1px solid var(--card-border);
    }

    .progress-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .progress-title {
      font-weight: 700;
    }

    .progress-percent {
      color: var(--primary);
      font-weight: 800;
    }

    .progress-track {
      width: 100%;
      height: 8px;

      margin-top: 13px;

      overflow: hidden;

      border-radius: 20px;

      background: rgba(255,255,255,0.08);
    }

    .progress-fill {
      width: 35%;
      height: 100%;

      border-radius: inherit;

      background: linear-gradient(
        90deg,
        var(--primary-dark),
        var(--primary)
      );
    }

    .progress-meta {
      display: flex;
      justify-content: space-between;

      margin-top: 10px;

      color: var(--muted);
      font-size: 11px;
    }

    /* ================= FEATURE GRID ================= */

    .feature-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 11px;
    }

    .feature-card {
      position: relative;

      min-height: 135px;

      padding: 17px;

      display: flex;
      flex-direction: column;
      justify-content: space-between;

      border: 1px solid var(--card-border);
      border-radius: 19px;

      background: var(--card);

      overflow: hidden;

      transition:
        transform 0.2s ease,
        border-color 0.2s ease;
    }

    .feature-card:active {
      transform: scale(0.97);
    }

    .feature-card:hover {
      border-color: rgba(37,197,138,0.35);
    }

    .feature-icon {
      width: 42px;
      height: 42px;

      display: grid;
      place-items: center;

      border-radius: 13px;

      background: rgba(37,197,138,0.1);

      font-size: 20px;
    }

    .feature-card h4 {
      margin-top: 12px;
      font-size: 14px;
    }

    .feature-card p {
      margin-top: 3px;
      color: var(--muted);
      font-size: 10px;
    }

    /* ================= DAILY AYAH ================= */

    .ayah-card {
      padding: 23px;

      border-radius: var(--radius);

      background:
        linear-gradient(
          145deg,
          rgba(217,180,91,0.12),
          rgba(255,255,255,0.035)
        );

      border: 1px solid rgba(217,180,91,0.15);
    }

    .ayah-label {
      color: var(--gold);
      font-size: 11px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 1px;
    }

    .ayah-arabic {
      margin-top: 18px;

      font-family: "Amiri", serif;
      font-size: 28px;
      line-height: 1.9;

      text-align: right;
      direction: rtl;
    }

    .ayah-translation {
      margin-top: 14px;

      color: var(--muted);
      font-size: 13px;
      font-style: italic;
    }

    .ayah-reference {
      margin-top: 12px;

      color: var(--gold);
      font-size: 11px;
      font-weight: 700;
    }

    /* ================= QUICK ACTIONS ================= */

    .quick-actions {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 9px;
    }

    .quick-btn {
      min-height: 82px;

      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;

      gap: 7px;

      border: 1px solid var(--card-border);
      border-radius: 16px;

      background: var(--card);
      color: var(--text);

      font-size: 11px;
      font-weight: 600;
    }

    .quick-btn span:first-child {
      font-size: 20px;
    }

    /* ================= QUIZ ================= */

    #quizGame,
    #quizResult {
      padding: 20px;

      border-radius: var(--radius);

      background: var(--card);
      border: 1px solid var(--card-border);
    }

    #quizResult {
      display: none;
    }

    .quiz-question {
      font-size: 18px;
      font-weight: 700;
      margin-bottom: 18px;
    }

    /* Compatibility IDs for existing quiz JS */

    #quizScore,
    #quizFeedback,
    #nextQuestion,
    #finalScore,
    #totalQuestions,
    #correctAnswers {
      margin-top: 10px;
    }

    /* ================= BOTTOM NAV ================= */

    .bottom-nav {
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;

      z-index: 1000;

      display: grid;
      grid-template-columns: repeat(5, 1fr);

      padding:
        9px
        8px
        calc(9px + env(safe-area-inset-bottom));

      background: rgba(7,17,31,0.94);
      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);

      border-top: 1px solid var(--card-border);
    }

    .nav-item {
      min-height: 55px;

      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;

      gap: 3px;

      border: 0;
      background: transparent;
      color: #718095;

      font-size: 9px;
      font-weight: 600;
    }

    .nav-item span:first-child {
      font-size: 19px;
    }

    .nav-item.active {
      color: var(--primary);
    }

    /* ================= RESPONSIVE ================= */

    @media (min-width: 700px) {

      .topbar {
        padding-left: 30px;
        padding-right: 30px;
      }

      main {
        padding: 35px 25px;
      }

      .feature-grid {
        grid-template-columns: repeat(4, 1fr);
      }

      .hero {
        padding: 45px;
      }

      .quick-actions {
        grid-template-columns: repeat(6, 1fr);
      }

      .bottom-nav {
        left: 50%;
        right: auto;
        transform: translateX(-50%);

        width: min(650px, 100%);

        border: 1px solid var(--card-border);
        border-bottom: 0;

        border-radius: 20px 20px 0 0;
      }
    }
  </style>
</head>

<body>

  <div class="app-shell">

    <!-- =====================================================
         HEADER
         ===================================================== -->

    <header class="topbar">

      <a href="#home" class="brand">

        <div class="brand-icon">
          ☪
        </div>

        <div class="brand-text">
          <h1>Know About Islam</h1>
          <span>Islamic Religious Knowledge • V2</span>
        </div>

      </a>

      <div class="header-actions">

        <button
          class="icon-btn"
          id="themeToggle"
          type="button"
          aria-label="Toggle theme"
        >
          🌙
        </button>

        <button
          class="icon-btn"
          id="menuButton"
          type="button"
          aria-label="Open menu"
        >
          ☰
        </button>

      </div>

    </header>


    <!-- =====================================================
         MAIN CONTENT
         ===================================================== -->

    <main id="home">

      <!-- HERO -->

      <section class="hero">

        <span class="hero-label">
          ✨ VERSION 2.0
        </span>

        <h2>
          Learn Islam.<br>
          Live Islam.<br>
          Grow with knowledge.
        </h2>

        <p>
          Explore Qur'an, Hadith, Adhkar, Fiqh, Sunnah and
          Islamic principles in one learning experience.
        </p>

        <div class="arabic">
          وَقُلْ رَبِّ زِدْنِي عِلْمًا
        </div>

      </section>


      <!-- GLOBAL SEARCH -->

      <section class="search-wrapper">

        <span class="search-icon">
          🔎
        </span>

        <input
          type="search"
          id="globalSearch"
          placeholder="Search Qur'an, Hadith, Fiqh, Adhkar..."
          autocomplete="off"
        >

      </section>


      <!-- LEARNING PROGRESS -->

      <section class="section">

        <div class="section-heading">

          <h3>
            Your Learning Journey
          </h3>

          <span>
            V2 Dashboard
          </span>

        </div>

        <div class="progress-card">

          <div class="progress-top">

            <span class="progress-title">
              Islamic Knowledge
            </span>

            <span
              class="progress-percent"
              id="learningPercent"
            >
              35%
            </span>

          </div>

          <div class="progress-track">

            <div
              class="progress-fill"
              id="learningProgress"
