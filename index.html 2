            <div class="feature-icon">
              🎯
            </div>

            <div>
              <h4>Quiz</h4>
              <p>Test your knowledge.</p>
            </div>

          </a>


          <a
            href="#tasbih"
            class="feature-card"
            data-section="tasbih"
          >

            <div class="feature-icon">
              📿
            </div>

            <div>
              <h4>Tasbih</h4>
              <p>Count your remembrance.</p>
            </div>

          </a>

        </div>

      </section>


      <!-- DAILY AYAH -->

      <section class="section">

        <div class="section-heading">

          <h3>
            Ayah for Reflection
