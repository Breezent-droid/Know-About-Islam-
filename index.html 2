  <!-- =====================================================
       V2 FOUNDATION JAVASCRIPT
       ===================================================== -->

  <script>

    /* ============================
       V2 LOCAL PROGRESS
       ============================ */

    const KAI_PROGRESS_KEY =
      "know_about_islam_v2_progress";

    let kaiProgress = {
      lessons: 0,
      streak: 0,
      percent: 35
    };

    try {

      const saved =
        localStorage.getItem(KAI_PROGRESS_KEY);

      if (saved) {
        kaiProgress = {
          ...kaiProgress,
          ...JSON.parse(saved)
        };
      }

    } catch (error) {

      console.log(
        "V2 progress storage unavailable."
      );

    }


    function saveProgress() {

      try {

        localStorage.setItem(
          KAI_PROGRESS_KEY,
          JSON.stringify(kaiProgress)
        );

      } catch (error) {

        console.log(
          "Unable to save V2 progress."
        );

      }

    }


    function updateProgressUI() {

      const percent =
        document.getElementById(
          "learningPercent"
        );

      const progress =
        document.getElementById(
          "learningProgress"
        );

      const lessons =
        document.getElementById(
          "lessonsCompleted"
        );

      const streak =
        document.getElementById(
          "learningStreak"
        );


      if (percent) {
        percent.textContent =
          `${kaiProgress.percent}%`;
      }


      if (progress) {
        progress.style.width =
          `${kaiProgress.percent}%`;
      }


      if (lessons) {
        lessons.textContent =
          `${kaiProgress.lessons} lessons completed`;
      }


      if (streak) {
        streak.textContent =
          `🔥 ${kaiProgress.streak} day streak`;
      }

    }


    updateProgressUI();


    /* ============================
       NAVIGATION
       ============================ */

    function goToSection(sectionId) {

      const target =
        document.getElementById(sectionId);

      if (!target) return;

      target.scrollIntoView({
        behavior: "smooth",
        block: "start"
      });

    }


    document
      .querySelectorAll("[data-nav]")
      .forEach(button => {

        button.addEventListener(
          "click",
          () => {

            const section =
              button.dataset.nav;

            goToSection(section);

            document
              .querySelectorAll(".nav-item")
              .forEach(item =>
                item.classList.remove("active")
              );

            button.classList.add("active");

          }
        );

      });


    document
      .querySelectorAll("[data-section]")
      .forEach(card => {

        card.addEventListener(
          "click",
          event => {

            event.preventDefault();

            goToSection(
              card.dataset.section
            );

          }
        );

      });


    document
      .querySelectorAll("[data-action]")
      .forEach(button => {

        button.addEventListener(
          "click",
          () => {

            goToSection(
              button.dataset.action
            );

          }
        );

      });


    /* ============================
       GLOBAL SEARCH
       ============================ */

    const globalSearch =
      document.getElementById(
        "globalSearch"
      );


    if (globalSearch) {

      globalSearch.addEventListener(
        "keydown",
        event => {

          if (
            event.key.toLowerCase() !==
            "enter"
          ) {
            return;
          }

          const query =
            globalSearch.value
              .trim()
              .toLowerCase();


          if (!query) return;


          const destinations = {
            quran: "quran",
            qur: "quran",
            hadith: "hadith",
            hadeeth: "hadith",
            adhkar: "adhkar",
            dhikr: "adhkar",
            fiqh: "fiqh",
            sunnah: "sunnah",
            principle: "principles",
            principles: "principles",
            quiz: "quiz",
            tasbih: "tasbih"
          };


          let destination = null;


          for (
            const keyword in destinations
          ) {

            if (query.includes(keyword)) {

              destination =
                destinations[keyword];

              break;

            }

          }


          if (destination) {

            goToSection(destination);

          } else {

            alert(
              `Search engine ready for V2.\n\n`
              + `You searched for: "${globalSearch.value}"\n\n`
              + `Our full Qur'an + Hadith + Fiqh search will be connected next.`
            );

          }

        }
      );

    }


    /* ============================
       THEME BUTTON
       ============================ */

    const themeToggle =
      document.getElementById(
        "themeToggle"
      );


    if (themeToggle) {

      themeToggle.addEventListener(
        "click",
        () => {

          document.body.classList.toggle(
            "light-mode"
          );


          const light =
            document.body.classList.contains(
              "light-mode"
            );


          themeToggle.textContent =
            light ? "☀️" : "🌙";

        }
      );

    }


    /* ============================
       MENU BUTTON
       ============================ */

    const menuButton =
      document.getElementById(
        "menuButton"
      );


    if (menuButton) {

      menuButton.addEventListener(
        "click",
        () => {

          alert(
            "Know About Islam V2 Menu\n\n"
            + "📖 Qur'an\n"
            + "📜 Hadith\n"
            + "🤲 Adhkar\n"
            + "🕌 Fiqh\n"
            + "🌙 Sunnah\n"
            + "🧭 Principles\n"
            + "🎯 Quiz\n"
            + "📿 Tasbih\n\n"
            + "More features coming."
          );

        }
      );

    }


    /* ============================
       VERSION LOG
       ============================ */

    console.log(
      "%c Know About Islam V2.0 ",
      "background:#25c58a;color:#07111f;font-weight:bold;padding:6px;"
    );

    console.log(
      "V2 Foundation loaded successfully."
    );

  </script>


  <!-- Existing application logic -->
  <script src="app.js"></script>
<script src="app-v2.js"></script>

</body>
</html>
